
PORT=4000

# ใช้เข้ารหัส JWT token - ใส่ค่าอะไรก็ได้ที่สุ่ม/คาดเดายาก
JWT_SECRET=pormuengdeadisusrumai

# URL ของหน้าเว็บฝั่ง frontend (ใช้สร้างลิงก์ยืนยันอีเมล และ redirect กลับหลังยืนยัน)
FRONTEND_URL=http://localhost:5500/frontend

# ตั้งค่า SMTP สำหรับส่งอีเมลจริง
# ตัวอย่างสำหรับ Gmail: ต้องเปิด 2-Step Verification แล้วสร้าง "App Password"
# ที่ https://myaccount.google.com/apppasswords แล้วใช้รหัสนั้นแทนรหัสผ่านจริง
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="How to Learn! <no-reply@matheo.app>"
